# 이 파일을 .env.a로 복사하세요. 비밀값은 커밋하지 않습니다.
# pipelines/server/server_run.py는 시나리오 A로 고정됩니다. RFP_SCENARIO는 run.py 선택용입니다.
# 설정 읽기 확인: python -m pipelines.server.server_run check-config (모델·API 호출 없음)
# A 로더: pipelines.server.server_local_generation / pipelines.server.server_local_embedding
RFP_SCENARIO=A

# A 청킹 기본값. fixed로 복귀하려면 명시적으로 지정하고 해당 인덱스를 선택하세요.
# 설정 변경은 이미 저장된 인덱스를 바꾸지 않습니다. 다른 전략은 별도 경로에 build하세요.
RFP_CHUNKING_STRATEGY=overview_additive
RFP_EMBEDDING_CONTEXT=none

# README 다운로드 명령의 저장 위치와 일치하는 기본값
A_MODELS_DIR=models
A_GENERATION_MODEL=generation_model
A_EMBEDDING_MODEL=default_model
A_RERANK_MODEL=bge-reranker-v2-m3
RETRIEVAL_REWRITE=off

# OpenAI: A 답변 생성·임베딩은 로컬 모델이라 쓰지 않지만,
# 평가 판정기(pipelines/server/server_run.py evaluate --judge-model)를 쓰려면 OPENAI_API_KEY가 필요합니다.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5-mini

# langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true

# 담당자 고유 영문 이니셜을 한 번 설정 (예: dyk, shn, chy, yjk, dbp, shk)
# 실험 ID는 이니셜-0001, 이니셜-0002 순서로 자동 생성
EXPERIMENT_OWNER=
