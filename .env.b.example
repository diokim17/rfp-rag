# 이 파일을 .env.b로 복사하세요. 비밀값은 커밋하지 않습니다.
# pipelines/api/api_run.py는 시나리오 B로 고정됩니다. RFP_SCENARIO는 run.py 선택용입니다.
# 설정 읽기 확인: python -m pipelines.api.api_run check-config (모델·API 호출 없음)
# A 로더: pipelines.server.server_local_generation / pipelines.server.server_local_embedding
RFP_SCENARIO=B

# 시나리오 A: pipelines/api/api_run.py의 공용 모델 경로 아래에 저장한 모델 하위 폴더 이름
# 예: generate/model-a → A_GENERATION_MODEL=model-a
# 예: embedding/model-b → A_EMBEDDING_MODEL=model-b
A_GENERATION_MODEL=
A_EMBEDDING_MODEL=
# 리랭커(선택): /home/spai1313/models/rerank/<폴더> 이름. 비우면 A는 모델 없는 lexical 리랭킹 사용
# 예: rerank/bge-reranker-v2-m3 → A_RERANK_MODEL=bge-reranker-v2-m3
A_RERANK_MODEL=

# 시나리오 B: OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5-mini

# B 기준 인덱스 청킹 설정
RFP_CHUNKING_STRATEGY=structured
RFP_STRUCTURED_CHUNKING_VERSION=2

# langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true

# 담당자 고유 영문 이니셜을 한 번 설정 (예: dyk, shn, chy, yjk, dbp, shk)
# 실험 ID는 이니셜-0001, 이니셜-0002 순서로 자동 생성
EXPERIMENT_OWNER=
