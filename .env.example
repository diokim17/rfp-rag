# 시나리오 선택: A=서버 모델 직접 추론, B=OpenAI API (기본)
# 설정 읽기 확인: python run.py check-config (모델·API 호출 없음)
# A 추론은 scenario_a_generation / scenario_a_embedding 담당 모듈 구현 필요
RFP_SCENARIO=B

# 시나리오 A: run.py의 공용 모델 경로 아래에 저장한 모델 하위 폴더 이름
# 예: generate/model-a → A_GENERATION_MODEL=model-a
# 예: embedding/model-b → A_EMBEDDING_MODEL=model-b
A_GENERATION_MODEL=
A_EMBEDDING_MODEL=

# 시나리오 B: OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5-mini

# langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true

# 담당자 고유 영문 이니셜을 한 번 설정 (예: dyk, shn, chy, yjk, dbp, shk)
# 실험 ID는 이니셜-0001, 이니셜-0002 순서로 자동 생성
EXPERIMENT_OWNER=
