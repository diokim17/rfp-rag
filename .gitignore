# Local environment variables and secrets
.env
.env.*
!.env.example

# Markdown은 README와 아래의 공유용 보고서만 허용
*.[mM][dD]
![rR][eE][aA][dD][mM][eE].[mM][dD]

# Project data (keep only directory placeholders)
/data/*
!/data/raw/
/data/raw/*
!/data/raw/.gitkeep
!/data/processed/
/data/processed/*
!/data/processed/.gitkeep

# Generated artifacts and local Python environment
/indexes/*
!/indexes/.gitkeep

# 실행 결과 JSON 및 원문이 포함된 산출물은 제외
/results/*
!/results/.gitkeep
# 원문·민감정보를 제거한 평가 요약만 reports/에 선별하여 공유
!/results/reports/
/results/reports/*
!/results/reports/*.[mM][dD]
!/results/reports/*.csv

# Local Python environment
.venv/
__pycache__/
*.py[cod]
.DS_Store
.experiment-state/
